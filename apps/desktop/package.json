{
  "name": "@pyn/desktop",
  "version": "1.3.8",
  "private": true,
  "description": "Pyn Desktop — Electron app (Mac, Windows)",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:html-grid": "VITE_FLOW_HTML_GRID=1 vite",
    "build": "tsc --noEmit && vite build && electron-builder",
    "build:mac": "tsc --noEmit && vite build && electron-builder --mac",
    "build:win": "tsc --noEmit && vite build && electron-builder --win",
    "build:icons": "node ../../scripts/build-icons.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/roboto-flex": "^5.2.8",
    "@fontsource/arimo": "^5.2.8",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@glideapps/glide-data-grid-cells": "^6.0.3",
    "@pyn/core": "workspace:*",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.14.5",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.19.1",
    "https-proxy-agent": "^9.0.0",
    "i18next": "^26.2.0",
    "lodash": "^4.18.1",
    "lucide-react": "^0.460.0",
    "maplibre-gl": "^5.24.0",
    "marked": "^4.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-responsive-carousel": "^3.2.23",
    "tailwind-merge": "^2.5.5",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@pyn/tsconfig": "workspace:*",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "app.pyn.desktop",
    "productName": "Pyn",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon-source.png"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "icon": "build/icon-source.png"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-source.png",
      "artifactName": "Pyn ${version}.exe"
    },
    "portable": {
      "artifactName": "Pyn ${version}.exe",
      "requestExecutionLevel": "user"
    }
  }
}
