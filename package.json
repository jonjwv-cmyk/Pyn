{
  "name": "pyn",
  "version": "0.0.1",
  "private": true,
  "description": "Pyn — Electron desktop + React Native mobile",
  "scripts": {
    "dev:desktop": "pnpm --filter @pyn/desktop dev",
    "dev:mobile": "pnpm --filter @pyn/mobile start",
    "build:desktop": "pnpm --filter @pyn/desktop build",
    "build:desktop:mac": "pnpm --filter @pyn/desktop build:mac",
    "build:desktop:win": "pnpm --filter @pyn/desktop build:win",
    "build:mobile:android": "pnpm --filter @pyn/mobile android",
    "build:mobile:ios": "pnpm --filter @pyn/mobile ios",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20"
  }
}
